@@ -862,5 +862,11 @@ bool uvm_gpu_tracking_semaphore_is_value_completed(uvm_gpu_tracking_semaphore_t
         return true;
     }
 
+    // No progress since the last update (payload == low 32 bits of completed_value): the locked update would just
