+// True if some engine in the table has a non-stall vector in leaf 'leafIdx' (otherwise the leaf never matters)
+static NvBool
+_intrLeafHasNonStallVector
+(
+    InterruptTable *pIntrTable,
+    NvU32           leafIdx
+)
+{
+    InterruptTableIter iter;
+
+    for (iter = vectIterAll(pIntrTable); vectIterNext(&iter);)
+    {
+        NvU32 vec = ((INTR_TABLE_ENTRY *)iter.pValue)->intrVectorNonStall;
+        if ((vec != NV_INTR_VECTOR_INVALID) &&
+            (vec >= NV_CTRL_INTR_LEAF_IDX_TO_GPU_VECTOR_START(leafIdx)) &&
+            (vec <= NV_CTRL_INTR_LEAF_IDX_TO_GPU_VECTOR_END(leafIdx)))
+            return NV_TRUE;
+    }
+    return NV_FALSE;
+}
