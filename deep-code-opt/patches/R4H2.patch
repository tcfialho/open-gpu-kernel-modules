diff --git a/kernel-open/common/inc/nv-linux.h b/kernel-open/common/inc/nv-linux.h
index f377db1..a0630c3 100644
--- a/kernel-open/common/inc/nv-linux.h
+++ b/kernel-open/common/inc/nv-linux.h
@@ -1562,7 +1562,9 @@ static inline void nv_wait_open_complete(nv_linux_file_private_t *nvlfp)
 
 static inline NvBool nv_is_open_complete(nv_linux_file_private_t *nvlfp)
 {
-    return completion_done(&nvlfp->open_complete);
+    // completion_done() takes the completion's irqsave lock on every poll(); a plain acquire load of 'done' is enough
